{
  "expo": {
    "name": "E-Khanij 2.0 Exploration",
    "slug": "ekhanij-exploration",
    "version": "2.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "scheme": "ekhanij",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#2e6f54"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.gov.ekhanij.exploration"
    },
    "android": {
      "package": "in.gov.ekhanij.exploration"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermissionMessage": "E-Khanij needs location for field verification and site visits."
        }
      ]
    ]
  }
}
